        <rdfs:subClassOf rdf:resource="http://www.geneontology.org/formats/oboInOwl#ObsoleteClass"/>
        <obo:IAO_0000115 xml:lang="en">OBSOLETE. Unilateral facial pain persisting or recurring for at least 3 months in the distribution(s) of one or more branches of the trigeminal nerve, with variable sensory changes, caused by herpes zoster.</obo:IAO_0000115>
        <obo:IAO_0000119>PMID:32103673</obo:IAO_0000119>
