    <!-- http://purl.obolibrary.org/obo/OHD_0008045 -->

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/OHD_0008045">
        <obo:IAO_0000115 xml:lang="en">Alternative label for a chemical adhering to the International Union of Pure and Applied Chemistry (IUPAC) nomenclature of organic, inorganic, or polymer chemistry .</obo:IAO_0000115>
