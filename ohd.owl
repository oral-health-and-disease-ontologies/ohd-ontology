        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001091"/>
        <obo:IAO_0000115 xml:lang="en">A tooth that is either an incisor or a canine.</obo:IAO_0000115>
        <obo:IAO_0000117>Bill Duncan</obo:IAO_0000117>
        <rdfs:label xml:lang="en">Anterior Tooth</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000308 -->

