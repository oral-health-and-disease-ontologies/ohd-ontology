        <obo:IAO_0000115 xml:lang="en">OBSOLETE. Attacks of SUNFA occurring for more than 1 year without remission, or with remission periods lasting less than 3 months.</obo:IAO_0000115>
        <obo:IAO_0000119>PMID:32103673</obo:IAO_0000119>
        <obo:IAO_0000231 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000228"/>
