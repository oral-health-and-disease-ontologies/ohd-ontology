        <oboInOwl:hasDbXref>MA:0002819</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:244691004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Coronoid_process_of_the_mandible</oboInOwl:hasDbXref>
