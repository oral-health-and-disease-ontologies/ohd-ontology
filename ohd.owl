        <oboInOwl:hasRelatedSynonym>peridontal membrane</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>peridontium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>periodontium</oboInOwl:hasRelatedSynonym>
