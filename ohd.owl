    <!-- http://purl.obolibrary.org/obo/OHD_0000196 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000196">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OHD_0000022"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000136"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000022"/>
        <obo:IAO_0000115 xml:lang="en">A metallic inlay restoration procedure that uses titanium to restore the tooth.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <rdfs:label xml:lang="en">titanium inlay restoration procedure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000197 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000197">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000057"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000019"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000052"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A visual and tactile examination in which the clinician evaluates the status of the patient&apos;s oral cavity and related areas. An oral evaluation is performed as part of a dental exam. The examination may also include the results of tests, such as radiographs, pulp vitality, etc.</obo:IAO_0000115>
        <obo:IAO_0000116>This class was created in order to associate oral evaluations with dental findings that came about as the result of a dental exam. The data source I am working with has records that show multiple oral evalutions were performed on the same day. For example, the data source may have records that show a periodic oral evaluation, comprehensive oral evaluation, and comprehensive periodontal evaluation are performed on the same day. However, the finding(s) for these evaluations is/are stored in a separate table with only the patient id and date to associate the finding with the exam. There is no information to link the finding to a particular evaluation. 

As a work around (i.e., hack!), I&apos;ve made oral evaluations be part of the dental examination. There is a case to be made that oral evaluations should be a subclass of dental exam, but, such a representation, would make representing the finding information (associated with a particular oral evaluation) difficult.</obo:IAO_0000116>
        <obo:IAO_0000116>Titus Schleyer 1/14/2014: updated definition

Also, regarding Bill&apos;s comment on the fact that multiple examinations can occur on the same day (e.g.  periodic oral evaluation, comprehensive oral evaluation and comprehensive periodontal evaluation): From a billing and clinical perspective,  these are separate. For instance, a comprehensive oral evaluation has a larger scope than a periodic oral evaluation, while a  comprehensive periodontal evaluation is focused primarily on gums and supporting tissues.</obo:IAO_0000116>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <rdfs:label xml:lang="en">oral evaluation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000198 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000198">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000197"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OHD_0000025"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OHD_0000032"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An oral evaluation performed on a patient of record (at an interval specified by the dentist) to determine any changes in the patients dental and medical health status since a previous evaluation. It includes an oral cancer evaluation and periodontal screening where indicated, and may require interpretation of information acquired through additional diagnostic procedures.</obo:IAO_0000115>
        <obo:IAO_0000116>Titus Schleyer 1/1/2014: updated definition</obo:IAO_0000116>
        <obo:IAO_0000119>ISBN:1935201387#CDT 2011-2012 Current Dental Terminology, Chapter 1</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <rdfs:label xml:lang="en">periodic oral evaluation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000199 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000199">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000154"/>
        <obo:IAO_0000115 xml:lang="en">A resin crown restoration procedure in which the artificial crown has been produced beforehand.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <rdfs:label xml:lang="en">prefabricated resin crown restoration procedure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000200 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000200">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000010"/>
        <obo:IAO_0000115 xml:lang="en">A dental finding in which there were no oral health issues were reported.</obo:IAO_0000115>
        <obo:IAO_0000116>The intent of the class is to represent those case in which a dental exam is performed on patient, no finding is reported for the exam.  This could mean that the patients mouth is healthy; the patient had an issue but the examiner failed to report it; or (perhaps) that the patient has some oral health issue, but there are no new issues to report.

The label of the class may need to be changed.</obo:IAO_0000116>
        <obo:IAO_0000116>Titus Schleyer 1/14/2014: added &quot;issue&quot; to definition</obo:IAO_0000116>
        <obo:IAO_0000117>Bill Duncan</obo:IAO_0000117>
        <obo:IAO_0000117>PERSON: Bill Duncan</obo:IAO_0000117>
        <obo:IAO_0000117>a role that inheres in a person who licensed to provide health care</obo:IAO_0000117>
        <rdfs:label xml:lang="en">no oral health issues reported</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000201 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000201">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000197"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OHD_0000025"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OHD_0000032"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An oral evaluation limited to a specific oral health problem or complaint. This may require interpretation of information acquired through additional diagnostic procedures. Typically, patients receiving this type of evaluation present with a specific problem and/or dental emergencies, trauma, acute infections, etc.</obo:IAO_0000115>
        <obo:IAO_0000119>ISBN:1935201387#CDT 2011-2012 Current Dental Terminology, Chapter 1</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <rdfs:label xml:lang="en">limited oral evaluation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000202 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000202">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000197"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000025"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000204"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000205"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An oral evaluation that is performed on new patients; established patients who have had a significant change in health conditions or other unusual circumstances; or established patients who have been absent from active treatment for three or more years. It is a thorough evaluation and recording of the extraoral and intraoral hard and soft tissues. It may require interpretation of information acquired through additional diagnostic procedures. 
This includes an evaluation for oral cancer where indicated, the evaluation and recording of the patients dental and medical history and a general health assessment.  It may include the evaluation and recording of dental caries, missing or unerupted teeth, restorations, existing prostheses, occlusal relationships, periodontal conditions (including periodontal screening and/or charting), hard and soft tissue anomalies, etc.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Titus Schleyer 1/1/2014: checked definition, looks okay</obo:IAO_0000116>
        <obo:IAO_0000119>ISBN:1935201387#CDT 2011-2012 Current Dental Terminology, Chapter 1</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <rdfs:label xml:lang="en">comprehensive oral evaluation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000203 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000203">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000197"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000204"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An oral evaluation performed on patients showing signs or symptoms of periodontal disease and for patients with risk factors for such disease, such as smoking or diabetes.  It includes evaluation of periodontal conditions, probing and charting, evaluation and recording of the patients dental and medical history and general health assessment.  It may include the evaluation and recording of dental caries, missing or unerupted teeth, restorations and occlusal relationships.</obo:IAO_0000115>
        <obo:IAO_0000116>Titus Schleyer 1/1/2014: slightly updated definition</obo:IAO_0000116>
        <obo:IAO_0000119>ISBN:1935201387#CDT 2011-2012 Current Dental Terminology, Chapter 1</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <rdfs:label xml:lang="en">comprehensive periodontal evaluation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000204 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000204">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000032"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OBI_0000067"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000052"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:unionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0001723"/>
                                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0001828"/>
                                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0003729"/>
                                        </owl:unionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0001723"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0001828"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0003729"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A physical examination of the soft tissue of the mouth, including the lips, mucosa, hard and soft palate, tongue, and floor of mouth.</obo:IAO_0000115>
        <obo:IAO_0000116>technically I don&apos;t need to include giniva since it is mucosa, but felt like it in the interest of avoiding questions</obo:IAO_0000116>
        <obo:IAO_0000119>Alan Ruttenberg</obo:IAO_0000119>
        <obo:IAO_0000119>http://www.dentistry.utoronto.ca/dpes/diagnostic/patients/extraoral-and-intraoral-soft-tissue-examination-patient</obo:IAO_0000119>
        <rdfs:label xml:lang="en">intraoral soft tissue exam</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000205 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000205">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000032"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom>
