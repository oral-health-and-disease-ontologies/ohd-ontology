        <rdfs:label>tongue muscle</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/c/c6/Gray1019.png</foaf:depiction>
    </owl:Class>
