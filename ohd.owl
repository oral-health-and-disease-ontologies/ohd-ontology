        <owl:annotatedTarget>Palatoglossus is a muscle that attaches to the soft palate and the tongue and is innervated by Cranial Nerve X via the pharyngeal plexus.[FEED]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-07-02</oboInOwl:date_retrieved>
        <oboInOwl:ontology>FEED</oboInOwl:ontology>
        <oboInOwl:url>http://www.feedexp.org</oboInOwl:url>
    </owl:Axiom>
