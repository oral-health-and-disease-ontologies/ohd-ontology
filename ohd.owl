        <obo:IAO_0000115 xml:lang="en">A fixed prosthodontics procedure in which a dental implant is permanently attached to the jaw.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:37:27Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">dental implant procedure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000249 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000249">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000247"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000254"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A removable prosthodontics procedure in which the prosthesis being constructed or fitted replaces all of the patient&apos;s teeth.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:10:46Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">complete denture procedure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000250 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000250">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000247"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000252"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A removable prosthodontics procedure in which the prosthesis being constructed or fitted replaces some but not all of the patient&apos;s teeth.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:12:21Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">removable partial denture procedure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000251 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000251">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000312"/>
        <obo:IAO_0000115 xml:lang="en">A fixed partial denture that is suppored and retained by underlying tissue and one or more dental implants.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T03:41:04Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">implant supported partial denture</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000252 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000252">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000310"/>
        <obo:IAO_0000115 xml:lang="en">A partial denture that is designed and constructed to be removed readily from the mouth.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T03:54:24Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">removable partial denture</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000253 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000253">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000301"/>
        <obo:IAO_0000115 xml:lang="en">A prosthesis that replaces all the natural teeth and associated structures in either the maxilla or mandible (or both).</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T03:32:49Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">complete denture</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000254 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000254">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000253"/>
        <obo:IAO_0000115 xml:lang="en">A complete denture that can be easily removed from a mouth.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0002-7282-0836"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T03:35:25Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">complete removable denture</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000255 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000255">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000253"/>
        <obo:IAO_0000115 xml:lang="en">A complete denture that is perminately attached to the mouth.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T03:33:42Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">complete fixed denture</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000256 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000256">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000253"/>
        <obo:IAO_0000115 xml:lang="en">A complete denture that replaces all the natural teeth and associated structures in both the maxilla and mandible.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T03:34:14Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">complete full denture</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000257 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000257">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000253"/>
        <obo:IAO_0000115 xml:lang="en">A complete denture that replaces all the natural teeth and associated structures in the mandible.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T03:34:47Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">complete lower denture</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000258 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000258">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000065"/>
        <obo:IAO_0000115 xml:lang="en">A progressive disease course wherein teeth break down due to acids produced by bacteria</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0002-7282-0836"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-06-06T21:29:59Z</dcterms:created>
        <rdfs:label xml:lang="en">tooth decay</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/OHD_0000258"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A progressive disease course wherein teeth break down due to acids produced by bacteria</owl:annotatedTarget>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Tooth_decay</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000259 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000259">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000302"/>
        <obo:IAO_0000115 xml:lang="en">A prosthetic tooth with an anchoring structure surgically implanted beneath the mucosal or periosteal layer or in the bone.</obo:IAO_0000115>
        <obo:IAO_0000119>http://medical-dictionary.thefreedictionary.com/tooth+implant</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
