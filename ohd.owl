    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0001085 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0001085">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000146"/>
        <obo:IAO_0000115 xml:lang="en">A noble metal dental restoration material that is composed of predominantly silver in composition and at least 25% by weight of palladium to provide nobility of the alloy.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="http://orcid.org/0000-0001-9625-1899"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-6424-4096"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-06-20T14:47:05Z</dcterms:created>
        <rdfs:label xml:lang="en">silver-palladium alloy metal dental restoration material</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0001086 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0001086">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000136"/>
        <obo:IAO_0000115 xml:lang="en">A titanium dental restoration material that contain pure titanium with minimum impurities.</obo:IAO_0000115>
        <obo:IAO_0000118>cp-titanium</obo:IAO_0000118>
        <dcterms:contributor rdf:resource="http://orcid.org/0000-0001-9625-1899"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-6424-4096"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-06-20T14:58:36Z</dcterms:created>
        <rdfs:comment>The maximum elemental mass fractions of impurities are: nitrogen 0.012–0.05 mass%, carbon 0.03–0.08 mass%, hydrogen 0.0125 mass%, oxygen 0.1–0.4 mass%, and iron 0.1–0.5 mass% contents.</rdfs:comment>
        <rdfs:label xml:lang="en">commercially pure titanium dental restoration material</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0001087 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0001087">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000136"/>
        <obo:IAO_0000115 xml:lang="en">A titanium dental restoration material that contains titanium with incorporation of alpha or beta microstructural stabilizers. Common microstructural stabilizers include aluminum, vanadium, niobium, cobalt, copper, nickel, or molybdenum.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="http://orcid.org/0000-0001-9625-1899"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-6424-4096"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-06-20T15:00:37Z</dcterms:created>
        <rdfs:label xml:lang="en">titanium alloy dental restoration material</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0002000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0002000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000060"/>
        <obo:IAO_0000115 xml:lang="en">A bodily process that involves the masticatory muscles of the head and neck region.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-7251-3026"/>
        <dcterms:created>2023-06-06T21:30:37Z</dcterms:created>
        <rdfs:label xml:lang="en">masticatory muscle activity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0005001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0005001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <obo:IAO_0000115 xml:lang="en">A data item that comes directly from a patient about how they function or feel in relation to the patient&apos;s health.  A patient reported outcome can include subjective feelings regarding symptoms, functions in daily life, physical, mental, emotional, spiritual, and social well-being, and satisfaction with the health  care that has been received.</obo:IAO_0000115>
        <obo:IAO_0000116>This term should be imported from more general ontology like OGMS.</obo:IAO_0000116>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-6378-1703"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-6424-4096"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9990-8331"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0003-7246-1252"/>
        <rdfs:label xml:lang="en">patient-reported outcome</rdfs:label>
        <skos:closeMatch>http://purl.obolibrary.org/obo/NCIT_C95401</skos:closeMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/OHD_0005001"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A data item that comes directly from a patient about how they function or feel in relation to the patient&apos;s health.  A patient reported outcome can include subjective feelings regarding symptoms, functions in daily life, physical, mental, emotional, spiritual, and social well-being, and satisfaction with the health  care that has been received.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.cancer.gov/publications/dictionaries/cancer-terms/def/patient-reported-outcome</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.pcori.org/sites/default/files/UMD-NORD-Telecon-Two-Patient-Reported-Outcomes.pdf</obo:IAO_0000119>
    </owl:Axiom>
    


