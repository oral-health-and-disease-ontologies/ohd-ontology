        <obo:IAO_0000115 xml:lang="en">A dental procedure that is performed on the pulp chamber and/or root canal of a tooth, or a part thereof.</obo:IAO_0000115>
        <obo:IAO_0000116>Titus Schleyer 1/14/2014: adapted definition</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON:Pedro Cott</obo:IAO_0000117>
