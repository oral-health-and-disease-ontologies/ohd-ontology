        <obo:IAO_0000116>For surgery on root of anterior tooth. Does not include placement of retrograde filling material. 

 ISBN:1935201387#CDT 2011-2012 Current Dental Terminology, Chapter 1</obo:IAO_0000116>
        <obo:cdt_label>apicoectomy/periradicular surgery - anterior</obo:cdt_label>
        <dc:identifier>D3410</dc:identifier>
