        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000138"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000140"/>
        <obo:IAO_0000115 xml:lang="en">A metallic onlay restoration procedure that uses titanium to restore the tooth.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <rdfs:label xml:lang="en">titanium onlay restoration procedure</rdfs:label>
    </owl:Class>
