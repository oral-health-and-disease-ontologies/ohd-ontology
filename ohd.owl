            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000045"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000116>Refers to labial/facial indirect resin bonded veneers. 

 ISBN:1935201387#CDT 2011-2012 Current Dental Terminology, Chapter 1</obo:IAO_0000116>
        <obo:cdt_label>labial veneer (resin laminate) - laboratory</obo:cdt_label>
        <dc:identifier>D2961</dc:identifier>
