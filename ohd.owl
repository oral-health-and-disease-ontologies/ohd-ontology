    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000303 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000303">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OHD_0000004"/>
                    <owl:Restriction>
