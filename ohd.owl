        <oboInOwl:hasRelatedSynonym>bicuspids</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>biscuspid</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>dens premolaris</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>dentes premolares</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>mandibular bicuspid</oboInOwl:hasRelatedSynonym>
