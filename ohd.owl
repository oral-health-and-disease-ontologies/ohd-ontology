    <!-- http://purl.obolibrary.org/obo/UBERON_0018103 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0018103">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000064"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010234"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The thinner portion of the muscle of the palatopharyngeal arch, originating in the region of the midline where its fibers interdigitate with the contralateral partner, then passing posterior to the levator veli palatini muscle to join the longitudinal layer of pharyngeal musculature; acts as a sort of sphincter, reducing the caliber of the isthmus of fauces at the palatopharyngeal arch.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FMA:46684</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:244801005</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>fasciculus posterior (musculus palatopharyngeus)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>fasciculus posterior musculus palatopharyngei</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>musculus sphincter palatopharyngeus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>palatopharyngeal sphincter</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>velopharyngeal sphincter</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0018103</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ohd/imports/uberon_import.owl"/>
        <rdfs:label>posterior fascicle of palatopharyngeus</rdfs:label>
