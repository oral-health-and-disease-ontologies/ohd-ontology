                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003675"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The portion of the teeth, occurring on the lingual or palatal aspects, that forms a convex protuberance at the cervical third of the anatomic crown. It represents the lingual or palatal developmental lobe of these teeth.</obo:IAO_0000115>
        <obo:UBPROP_0000012>FMA has no definition but places this generically with upper, lower, canine, incisor subclasses. Wiktionary states cingulum is lower jaw molar only, and cingulid is upper molar only</obo:UBPROP_0000012>
        <oboInOwl:hasDbXref>FMA:56731</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:245650005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Cingulum_(tooth)</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cingulum (dentis)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cingulum dentis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tooth cingulum</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0017295</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ohd/imports/uberon_import.owl"/>
        <rdfs:label>cingulum of tooth</rdfs:label>
    </owl:Class>
