    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0010271 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0010271">
        <rdfs:subClassOf rdf:resource="http://www.geneontology.org/formats/oboInOwl#ObsoleteClass"/>
        <obo:IAO_0000115 xml:lang="en">OBSOLETE. While no isolated facial equivalent of 3.4 Hemicrania continua, described in International Classification of Headache Disorders 3rd Edition,, has so far been clearly established, extension of pain into the face in hemicrania continua has been described. Thus, pain referral and/or radiation to oral and/or facial structures may cause diagnostic difficulties.</obo:IAO_0000115>
        <obo:IAO_0000119>PMID:32103673</obo:IAO_0000119>
        <obo:IAO_0000231 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000228"/>
        <obo:IAO_0100001 rdf:resource="http://purl.obolibrary.org/obo/PAIN_0010271"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0003-5583-4731"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-07-07T17:27:44Z</dcterms:created>
        <rdfs:label xml:lang="en">obsolete hemifacial continuous pain with autonomic symptoms</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0010272 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0010272">
        <rdfs:subClassOf rdf:resource="http://www.geneontology.org/formats/oboInOwl#ObsoleteClass"/>
        <obo:IAO_0000115 xml:lang="en">OBSOLETE. Attacks of variable duration of moderate or severe intraoral pain, without head pain, often accompanied by toothache-like symptoms, with mild autonomic and/or migrainous symptoms. Two subforms are represented by patients with relatively short attacks (1–4 hours) and those with longer attacks (&gt;4 hours).</obo:IAO_0000115>
        <obo:IAO_0000119>PMID:32103673</obo:IAO_0000119>
        <obo:IAO_0000231 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000228"/>
        <obo:IAO_0100001 rdf:resource="http://purl.obolibrary.org/obo/PAIN_0010272"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0003-5583-4731"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-07-07T17:28:50Z</dcterms:created>
        <rdfs:label xml:lang="en">obsolete neurovascular orofacial pain</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0010273 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0010273">
        <rdfs:subClassOf rdf:resource="http://www.geneontology.org/formats/oboInOwl#ObsoleteClass"/>
        <obo:IAO_0000115 xml:lang="en">OBSOLETE. Neurovascular orofacial pain that lasts between 1-4 hours.</obo:IAO_0000115>
        <obo:IAO_0000119>PMID:32103673</obo:IAO_0000119>
        <obo:IAO_0000231 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000228"/>
        <obo:IAO_0100001 rdf:resource="http://purl.obolibrary.org/obo/PAIN_0010273"/>
