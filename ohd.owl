    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000247 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000247">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000245"/>
        <obo:IAO_0000115 xml:lang="en">A prosthodontics procedure during which a removable prosthesis is either constructed or fitted to the patient&apos;s mouth.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:08:52Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">removable prosthodontics procedure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000248 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000248">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
