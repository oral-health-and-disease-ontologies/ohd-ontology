        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001754"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The part in the center of a tooth made up of living soft tissue and cells called odontoblasts[WP].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Dental_pulp</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001754"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>Material in the center of the dentine of the mature tooth. In secondary teeth the pulp contains blood vessels and odontoblast.[TAO]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-08-14</oboInOwl:date_retrieved>
        <oboInOwl:external_class>TAO:0005141</oboInOwl:external_class>
        <oboInOwl:ontology>TAO</oboInOwl:ontology>
        <oboInOwl:source>ZFIN:curator</oboInOwl:source>
