        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDT_1000023"/>
        <obo:IAO_0000116>Crown utilized as an interim restoration  of at least six months duration during restorative treatment to allow adequate time for healing or completion of other procedures.  This includes, but is not limited to changing vertical dimension, completing periodontal therapy or cracked-tooth  syndrome. This is not to be used as a temporary crown for a routine prosthetic restoration. 

 ISBN:1935201387#CDT 2011-2012 Current Dental Terminology, Chapter 1</obo:IAO_0000116>
        <obo:cdt_label>provisional crown</obo:cdt_label>
        <dc:identifier>D2799</dc:identifier>
        <rdfs:label>billing code D2799: provisional crown</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CDT_0002931 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CDT_0002931">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CDT_1000026"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000163"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:cdt_label>prefabricated stainless steel crown - permanent tooth</obo:cdt_label>
        <dc:identifier>D2931</dc:identifier>
        <rdfs:label>billing code D2931: prefabricated stainless steel crown - permanent tooth</rdfs:label>
    </owl:Class>
    


