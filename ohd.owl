        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ohd/imports/pain_import.owl"/>
        <rdfs:label xml:lang="en">periodontal pain due to endodontic infection</rdfs:label>
    </owl:Class>
    


