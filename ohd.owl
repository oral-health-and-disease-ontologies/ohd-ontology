    <!-- http://purl.obolibrary.org/obo/OHD_0000309 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000309">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000300"/>
        <obo:IAO_0000115 xml:lang="en">A dental implant retainer attachement procedure for fixed partial denture in which the retainer being attached to the implant body is to be used as a retainer for a ceramic fixed partial denture.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:41:10Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">dental implant retainer attachement procedure for ceramic fixed partial denture</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000310 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000310">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000301"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000302"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000111>partial denture</obo:IAO_0000111>
        <obo:IAO_0000115 xml:lang="en">A prosthesis that replaces one or more, but less than all, of the natural teeth and associated structures.</obo:IAO_0000115>
        <obo:IAO_0000117>Bill Duncan</obo:IAO_0000117>
        <obo:IAO_0000118>partial dental prothesis</obo:IAO_0000118>
        <obo:IAO_0000119>Mosby. Mosby&apos;s Dental Dictionary, 2nd Edition. Mosby, 2008. VitalBook file. p. 175</obo:IAO_0000119>
        <rdfs:label xml:lang="en">partial denture</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000311 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000311">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000312"/>
        <obo:IAO_0000115 xml:lang="en">A fixed partial denture that is suppored and retained by underlying tissue and some or all of the remaining teeth.</obo:IAO_0000115>
        <obo:IAO_0000116>Dan Caplan 12/13/2014:
Mosby&apos;s definition is not quite corrrect. The support could also include other teeth that are not adjacent to the endentulous area. The important point is that the prosthesis is supported by existing teeth (wherever they are in the arch), and not by the gingiva.</obo:IAO_0000116>
        <obo:IAO_0000117>Bill Duncan</obo:IAO_0000117>
        <obo:IAO_0000119>Mosby. Mosby&apos;s Dental Dictionary, 2nd Edition. Mosby, 2008. VitalBook file. p. 175-176</obo:IAO_0000119>
        <rdfs:label xml:lang="en">tooth-supported partial denture</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000312 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000312">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000310"/>
        <obo:IAO_0000115 xml:lang="en">A partial denture that is permanently attached to prepared natural teeth, roots, or implants.</obo:IAO_0000115>
        <obo:IAO_0000118>bridge</obo:IAO_0000118>
        <obo:IAO_0000119>Mosby. Mosby&apos;s Dental Dictionary, 2nd Edition. Mosby, 2008. VitalBook file. p. 175</obo:IAO_0000119>
        <rdfs:label xml:lang="en">fixed partial denture</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000313 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000313">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000004"/>
        <obo:IAO_0000115 xml:lang="en">A tooth restoration procedure in which a fixed partial denture (i.e., bridge) is attached to the supporting teeth.</obo:IAO_0000115>
        <obo:IAO_0000118>A tooth restoration procedure in which a fixed partial denture (i.e., bridge) is attached to the supporting teeth.</obo:IAO_0000118>
        <obo:IAO_0000118>bridge restoration procedure</obo:IAO_0000118>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <rdfs:label xml:lang="en">fixed partial denture restoration procedure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000314 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000314">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000319"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000052"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000112>A glass eye (see  http://en.wikipedia.org/wiki/Ocular_prosthesis)</obo:IAO_0000112>
        <obo:IAO_0000112>A prothetic hand (see http://bebionic.com)</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">A material to be added role that inheres in a material entity that replaces some missing body part.</obo:IAO_0000115>
        <obo:IAO_0000116>Bill Duncan / Alan Ruttenber 12/16/2014:

Prosthics may be either functional for non-functional. For example, a glass eye bears a prosthetic role, but it does not see.</obo:IAO_0000116>
        <obo:IAO_0000117>Alan Ruttenberg</obo:IAO_0000117>
        <obo:IAO_0000117>Bill Dunan</obo:IAO_0000117>
        <rdfs:label xml:lang="en">prosthetic role</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000315 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000315">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000314"/>
        <obo:IAO_0000112>A prosthic hand</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">A prosthetic role that is realized by activities in which the material entity (bearing the role) is used a manner that is similar to how the body part that the prosthesis replaces would be used.</obo:IAO_0000115>
        <obo:IAO_0000117>Alan Ruttenberg</obo:IAO_0000117>
        <obo:IAO_0000117>Bill Duncan</obo:IAO_0000117>
        <rdfs:label xml:lang="en">functional prosthetic role</rdfs:label>
    </owl:Class>
    


