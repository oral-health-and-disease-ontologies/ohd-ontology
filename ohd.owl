        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ohd/imports/pain_import.owl"/>
        <rdfs:label xml:lang="en">pulpal pain due to irreversible pulpitis resulting from tooth crack without evidence of missing tooth substance</rdfs:label>
    </owl:Class>
    


