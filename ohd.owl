        <rdfs:comment>ICOP number: 6.3</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ohd/imports/pain_import.owl"/>
        <rdfs:label xml:lang="en">persistent idiopathic dentoalveolar pain</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PAIN_0010285 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0010285">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0010284"/>
        <obo:IAO_0000115>Persistent unilateral intraoral dentoalveolar pain, rarely occurring in multiple sites, with variable features, recurring daily for more than 2 hours per day for more than 3 months, unaccompanied by somatosensory changes and in the absence of any preceding causative event.</obo:IAO_0000115>
        <obo:IAO_0000119>PMID:32103673</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0003-5583-4731"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-07-07T17:41:16Z</dcterms:created>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/PAIN_0010296"/>
        <rdfs:comment>ICOP number: 6.3.1</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ohd/imports/pain_import.owl"/>
        <rdfs:label xml:lang="en">persistent idiopathic dentoalveolar pain without somatosensory changes</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PAIN_0010286 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0010286">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0010284"/>
        <obo:IAO_0000115>Persistent unilateral intraoral dentoalveolar pain, rarely occurring in multiple sites, with variable features, recurring daily for more than 2 hours per day for more than 3 months and accompanied by negative and/or positive somatosensory changes, in the absence of any preceding causative event.</obo:IAO_0000115>
        <obo:IAO_0000119>PMID:32103673</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0003-5583-4731"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-07-07T17:41:53Z</dcterms:created>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/PAIN_0010296"/>
        <rdfs:comment>ICOP number: 6.3.2</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ohd/imports/pain_import.owl"/>
        <rdfs:label xml:lang="en">persistent idiopathic dentoalveolar pain with somatosensory changes</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PAIN_0010287 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0010287">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0010284"/>
        <obo:IAO_0000115>Unilateral intraoral dentoalveolar pain, rarely occurring in multiple sites, with variable features, recurring daily for more than 2 hours per day but for less than 3 months, in the absence of any preceding causative event.</obo:IAO_0000115>
        <obo:IAO_0000119>PMID:32103673</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0003-5583-4731"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-07-07T17:42:36Z</dcterms:created>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/PAIN_0010296"/>
        <rdfs:comment>ICOP number: 6.3.3</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ohd/imports/pain_import.owl"/>
        <rdfs:label xml:lang="en">probable persistent idiopathic dentoalveolar pain</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PAIN_0010288 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0010288">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0010275"/>
        <obo:IAO_0000115>Constant (unremitting) dull unilateral facial pain of mild to moderate intensity, accompanied by distinct attacks of moderate to severe pain in the same location lasting 10--30 minutes. There are no typical autonomic and/or migrainoid features accompanying either the constant pain or the additional pain attacks.</obo:IAO_0000115>
        <obo:IAO_0000119>PMID:32103673</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0003-5583-4731"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-07-07T17:43:15Z</dcterms:created>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/PAIN_0010296"/>
        <rdfs:comment>ICOP number: 6.4</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ohd/imports/pain_import.owl"/>
        <rdfs:label xml:lang="en">constant unilateral facial pain with additional attacks (CUFPA)</rdfs:label>
    </owl:Class>
    


