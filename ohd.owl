        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0000036"/>
        <obo:IAO_0000115>Pain that is characterized by its spatial features, such as the location at which it is experienced, its spatial extent, or the spatial relation between where it is experienced and where it originates.</obo:IAO_0000115>
        <obo:IAO_0000589>spatially specified pain (PAIN)</obo:IAO_0000589>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
