        <obo:IAO_0000115 xml:lang="en">OBSOLETE. Orofacial pains resembling presentations of primary headaches.</obo:IAO_0000115>
        <obo:IAO_0000119>PMID:32103673</obo:IAO_0000119>
        <obo:IAO_0000231 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000228"/>
