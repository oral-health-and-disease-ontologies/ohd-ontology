    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000243 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000243">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000044"/>
        <obo:IAO_0000115 xml:lang="en">A surgical dental procedure that is performed on the pulp chamber and/or root canal of a tooth, or a part thereof.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T02:26:59Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">surgical endodontic procedure</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/OHD_0000243"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:resource="http://purl.obolibrary.org/obo/OHD_0000003"/>
        <oboInOwl:is_inferred>true</oboInOwl:is_inferred>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000244 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000244">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000243"/>
        <obo:IAO_0000115 xml:lang="en">A surgical endodontic procure during which a root is removed from a multi-root tooth.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T02:35:48Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">root amputation procedure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000245 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000245">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000002"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000301"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A dental procedure during which some part of the mouth is replaced by or fitted for a prothesis.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T01:49:03Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">prosthodontics procedure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000246 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000246">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OHD_0000245"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
