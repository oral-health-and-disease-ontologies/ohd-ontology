    <!-- http://purl.obolibrary.org/obo/UBERON_0005090 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005090">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000061"/>
        <obo:IAO_0000115>Muscle structures are contractile cells, tissues or organs that are found in multicellular organisms[GO].</obo:IAO_0000115>
        <obo:IAO_0000232>in some organisms such as drosophila, muscles can be single cells. This class groups together all discrete muscle elements, from multicellular muscle organs in vertebrates, to individual single-cell muscles in drisophila</obo:IAO_0000232>
        <oboInOwl:hasDbXref>FMA:30316</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>musculus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>muscle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>muscle element</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0005090</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ohd/imports/uberon_import.owl"/>
        <rdfs:label>muscle structure</rdfs:label>
