        <oboInOwl:hasRelatedSynonym>peridontal fiber</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>peridontal fibre</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>peridontal ligament</oboInOwl:hasRelatedSynonym>
