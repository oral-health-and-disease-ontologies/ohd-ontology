        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-07-07T17:30:01Z</dcterms:created>
        <rdfs:label xml:lang="en">obsolete short-lasting neurovascular orofacial pain</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
