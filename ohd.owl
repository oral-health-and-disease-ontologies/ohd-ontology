        <obo:IAO_0000115>Unilateral or bilateral facial pain in the distribution(s) of one or more branches of the trigeminal nerve, indicative of neural damage and persisting or recurring for more than 3 months, but of unknown aetiology.</obo:IAO_0000115>
        <obo:IAO_0000119>PMID:32103673</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0003-5583-4731"/>
