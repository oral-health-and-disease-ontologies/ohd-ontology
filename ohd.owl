                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0002429"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0003700"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0015870"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A physical examination of the soft tissue of the head and neck with attention to the temporomandibular joint area.</obo:IAO_0000115>
        <obo:IAO_0000117>Alan Ruttenberg</obo:IAO_0000117>
        <obo:IAO_0000119>http://www.dentistry.utoronto.ca/dpes/diagnostic/patients/extraoral-and-intraoral-soft-tissue-examination-patient</obo:IAO_0000119>
        <rdfs:label xml:lang="en">extraoral soft tissue exam</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000206 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000206">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OHD_0000189"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OHD_0000302"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0001091"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000047"/>
        <obo:IAO_0000115 xml:lang="en">A natural, modified or prosthetic tooth</obo:IAO_0000115>
        <obo:IAO_0000117>Alan Ruttenberg</obo:IAO_0000117>
        <rdfs:label xml:lang="en">functional tooth</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000207 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000207">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000444"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000052"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000206"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OHD_0000004"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_8600148"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A target of material addition role that inheres in some part of a tooth and is realized in a process where dental material forms a new surface</obo:IAO_0000115>
        <obo:IAO_0000116>Can&apos;t say the role inheres in a surface as the problem may be that the  particular surface isn&apos;t present before the restoration.</obo:IAO_0000116>
        <obo:IAO_0000117>Alan Ruttenberg</obo:IAO_0000117>
        <rdfs:label xml:lang="en">tooth surface to be restored role</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000208 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000208">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000047"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000189"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A processed material that is part of a restored tooth and forms the part of a restored tooth where a the surface enamel of the restored tooth used to be.</obo:IAO_0000115>
        <obo:IAO_0000117>Alan Ruttenberg</obo:IAO_0000117>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <rdfs:label xml:lang="en">restored tooth surface</rdfs:label>
