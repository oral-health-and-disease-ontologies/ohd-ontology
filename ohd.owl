    <!-- http://purl.obolibrary.org/obo/PAIN_0000128 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0000128">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0000036"/>
        <obo:IAO_0000115>Pain that is characterized by its temporal features, such as its duration, its frequency of occurrence, or its pattern of occurrence over time.</obo:IAO_0000115>
        <obo:IAO_0000589>temporally specified pain (PAIN)</obo:IAO_0000589>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
