    <!-- http://purl.obolibrary.org/obo/UBERON_0016477 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0016477">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004529"/>
        <obo:IAO_0000115>The zygomatic process of the maxilla (malar process) is a rough triangular eminence, situated at the angle of separation of the anterior, zygomatic, and orbital surfaces. In front it forms part of the anterior surface. Behind it is concave, and forms part of the infratemporal fossa. Above it is rough and serrated for articulation with the zygomatic bone. Below it presents the prominent arched border which marks the division between the anterior and infratemporal surfaces.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasBroadSynonym>malar process</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>FMA:52895</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:272684007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Zygomatic_process_of_maxilla</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>malar process of maxilla</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>processus zygomaticus (maxilla)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>processus zygomaticus maxillae</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>zygomaticoorbital process of maxilla</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>zygomatic appendage of maxilla</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0016477</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ohd/imports/uberon_import.owl"/>
        <rdfs:label>zygomatic process of maxilla</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0016477"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The zygomatic process of the maxilla (malar process) is a rough triangular eminence, situated at the angle of separation of the anterior, zygomatic, and orbital surfaces. In front it forms part of the anterior surface. Behind it is concave, and forms part of the infratemporal fossa. Above it is rough and serrated for articulation with the zygomatic bone. Below it presents the prominent arched border which marks the division between the anterior and infratemporal surfaces.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Zygomatic_process_of_maxilla</oboInOwl:hasDbXref>
