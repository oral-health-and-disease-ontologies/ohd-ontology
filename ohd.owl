    <!-- http://purl.obolibrary.org/obo/OHD_0008051 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0008051">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000061"/>
        <obo:IAO_0000115 xml:lang="en">Apathological bodily process experienced as a feeling of sickness or discomfort in the stomach that may come with an urge to vomit.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0002-7282-0836"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-04-04T13:29:32Z</dcterms:created>
        <rdfs:comment>We&apos;re not using the symptom ontology &apos;nausea&apos; class, since this makes nausea a type of symptom, and this doesn&apos;t give a good way of stating what it&apos;s a symptom of. We prefer to use a &apos;symptom of&apos; relation. We also don&apos;t like the definition they give of symptom, since symptoms are not necessarily perceived or reported.</rdfs:comment>
        <rdfs:label xml:lang="en">nausea</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/OHD_0008051"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">Apathological bodily process experienced as a feeling of sickness or discomfort in the stomach that may come with an urge to vomit.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.cancer.gov/publications/dictionaries/cancer-terms/def/nausea</obo:IAO_0000119>
    </owl:Axiom>
    


