        <oboInOwl:hasDbXref>TADS:0000598</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0000496</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TGMA:0001837</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001723</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0003041</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000496</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>organ</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0003103</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
