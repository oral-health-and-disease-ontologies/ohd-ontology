        <oboInOwl:hasRelatedSynonym>porcelain clay</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>white bole</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>CHEBI:140503</oboInOwl:id>
