        <oboInOwl:hasDbXref>UMLS:C0026367</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Molar_(tooth)</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>dens molaris</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>molaris</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>molar</oboInOwl:hasRelatedSynonym>
