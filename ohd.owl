        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">Alternative label for a chemical adhering to the International Union of Pure and Applied Chemistry (IUPAC) nomenclature of organic, inorganic, or polymer chemistry .</owl:annotatedTarget>
        <obo:IAO_0000119>https://iupac.org/what-we-do/nomenclature/brief-guides/</obo:IAO_0000119>
