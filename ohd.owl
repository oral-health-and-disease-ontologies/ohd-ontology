    <!-- http://purl.obolibrary.org/obo/UBERON_0011535 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0011535">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002385"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001572"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The Chondroglossus is sometimes described as a part of the Hyoglossus, but is separated from it by fibers of the Genioglossus, which pass to the side of the pharynx. It is about 2 cm. long, and arises from the medial side and base of the lesser cornu and contiguous portion of the body of the hyoid bone, and passes directly upward to blend with the intrinsic muscular fibers of the tongue, between the Hyoglossus and Genioglossus.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FMA:46700</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:244787000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Chondroglossus</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>chondroglossal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>chondroglossus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>chondroglossal muscle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>musculus chondroglossus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0011535</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ohd/imports/uberon_import.owl"/>
        <rdfs:label>chondroglossus muscle</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011535"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The Chondroglossus is sometimes described as a part of the Hyoglossus, but is separated from it by fibers of the Genioglossus, which pass to the side of the pharynx. It is about 2 cm. long, and arises from the medial side and base of the lesser cornu and contiguous portion of the body of the hyoid bone, and passes directly upward to blend with the intrinsic muscular fibers of the tongue, between the Hyoglossus and Genioglossus.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Chondroglossus</oboInOwl:hasDbXref>
