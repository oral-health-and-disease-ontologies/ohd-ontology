        <oboInOwl:hasExactSynonym>retropharyngeal node</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>retropharyngeal glands</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>retropharyngeal lymph node</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0015869</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ohd/imports/uberon_import.owl"/>
        <rdfs:label>retropharyngeal lymph node</rdfs:label>
    </owl:Class>
    <owl:Axiom>
