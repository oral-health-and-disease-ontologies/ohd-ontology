    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/OHD_0000276"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A bruxism that occurs during sleep and is characterised by rhythmic (phasic) or non-rhythmic (tonic) movements of the jaw.</owl:annotatedTarget>
        <obo:IAO_0000119>PMCID: PMC6287494</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000277 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000277">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000260"/>
        <obo:IAO_0000115 xml:lang="en">A tooth disorder that is an outcome of a ruture or break of some part of the tooth.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-7251-3026"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-06-08T17:13:14Z</dcterms:created>
        <rdfs:label xml:lang="en">tooth fracture</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000278 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000278">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000301"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000259"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A prosthesis that forms the part of a prosthetic tooth  that is in direct contact with the bone and actually provides the fixation to the bone.</obo:IAO_0000115>
        <obo:IAO_0000119>http://www.ptcdental.com/dentaldictionary/i/implant-body/</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:22:55Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">dental implant body</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000279 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000279">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000301"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000259"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A prosthesis that forms the part of a prosthetic tooth to which the restoration is attached and supports the restoration.</obo:IAO_0000115>
        <obo:IAO_0000116>Bill Duncan 07/26/2017:
Implant abutments are conical-shaped, and are screwed into a dental implant integrated into the jawbone. Today, the most common form of implant abutments are made of tooth colored material to add a more natural look to the crown that covers the abutment. This type of abutment allows the crown to blend more appropriately with adjacent teeth as is the case with the high noble metal resin crowns and porcelain-fused to noble metal crowns.

(https://www.patientconnect365.com/DentalHealthTopics/Article/Abutment__Dental_Procedure_Code_Description)</obo:IAO_0000116>
        <obo:IAO_0000116>Bill Duncan 7/26/2017:
Most often the dental implant abutment is an intermediate component between the implant body and the restoration.</obo:IAO_0000116>
        <obo:IAO_0000119>http://www.ptcdental.com/dentaldictionary/a/abutment/</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:19:43Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">dental implant abutment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000280 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000280">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000301"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000259"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A prosthesis that forms the part of a prosthetic tooth which provides the prosthetic tooth with the functionallity and appearance of a natural tooth.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:27:20Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">dental implant crown</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000281 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000281">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000301"/>
        <obo:IAO_0000115 xml:lang="en">A prosthesis that is permanently attached attached to some part of the mouth.</obo:IAO_0000115>
        <obo:IAO_0000116>Bill Duncan 07/26/2017:
This class is used to group dental implants and fixed dentures under one term.</obo:IAO_0000116>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:00:32Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">fixed prothesis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000282 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000282">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000015"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OHD_0000284"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001091"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000115 xml:lang="en">A process during which the tooth is affected by an abrasive material.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-7251-3026"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-06-09T16:17:51Z</dcterms:created>
        <rdfs:label xml:lang="en">tooth abrasive process</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000283 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000283">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000278"/>
        <obo:IAO_0000115 xml:lang="en">A dental implant body fabricated to fit the supporting areas of mandible or maxilla with permucosal extensions for support and attachment of abutments.</obo:IAO_0000115>
        <obo:IAO_0000119>http://dentalimplants.uchc.edu/about/types.html</obo:IAO_0000119>
        <obo:IAO_0000119>http://implantdirect.co/ai/implantcatalogpdf/glossary.pdf</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:25:20Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">subperiosteal implant framework</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000284 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000284">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <obo:IAO_0000115 xml:lang="en">A material entity of a certain hardness and density that helps remove material from the surface of an entity.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-7251-3026"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-06-09T16:29:17Z</dcterms:created>
        <rdfs:label xml:lang="en">abrasive material</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000285 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000285">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000278"/>
        <obo:IAO_0000115 xml:lang="en">A dental implant body that is less that 3mm in diameter.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:24:40Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">mini dental implant body</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000286 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000286">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000242"/>
        <obo:IAO_0000115 xml:lang="en">An endodontic restorative procedure during which material is placed over exposed or nearly dental pulp in order to protect and promote healing of the dental pulp.</obo:IAO_0000115>
        <obo:IAO_0000119>https://en.wikipedia.org/wiki/Pulp_capping</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T02:23:54Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">pulp capping procedure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000287 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000287">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000407"/>
        <obo:IAO_0000115 xml:lang="en">A bruxism that occurs during wakeful-ness and is characterised by repetitive or sustained tooth contact and/or by bracing or thrusting of the mandible.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-7251-3026"/>
        <dcterms:created>2023-06-06T21:38:37Z</dcterms:created>
        <rdfs:label xml:lang="en">awake bruxism</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/OHD_0000287"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A bruxism that occurs during wakeful-ness and is characterised by repetitive or sustained tooth contact and/or by bracing or thrusting of the mandible.</owl:annotatedTarget>
        <obo:IAO_0000119>PMCID: PMC6287494</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000288 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000288">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0005001"/>
        <obo:IAO_0000115 xml:lang="en">A patient-reported outcome that reports an ufavorable outcome in regards to the patient&apos;s health.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9990-8331"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0003-7246-1252"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-01-17T15:48:15Z</dcterms:created>
        <rdfs:label xml:lang="en">patient-reported unfavorable outcome</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000289 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000289">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000243"/>
        <obo:IAO_0000115 xml:lang="en">A surgical endodontic procedure during which medications are placed inside the pulp chamber in order to induce the formation of living replacement tissue.</obo:IAO_0000115>
        <obo:IAO_0000119>http://www.neendosol.com/procedures/pulpal-regeneration/</obo:IAO_0000119>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T02:34:17Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">pulpal regeneration procedure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000290 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000290">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000271"/>
        <obo:IAO_0000115 xml:lang="en">A mechnical tooth lesion that formed as a result of some friction process.</obo:IAO_0000115>
        <obo:IAO_0000116>A tooth friction lesion is caused by a friction process involving an external object. For example, the clasp of an ill-fitting denture, pipe stem of a tobacco pipe, friction lesion of the interproximal areas caused by vigorous use of a tooth pick etc. An abrasive material is not involved in creating the friction lesion.</obo:IAO_0000116>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-7251-3026"/>
        <dcterms:created>2023-06-22T21:30:59Z</dcterms:created>
        <rdfs:label xml:lang="en">tooth friction lesion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000291 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000291">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000250"/>
        <obo:IAO_0000115 xml:lang="en">A removable partial denture procedure in which the prosthesis being constructed or fitted replaces some but not all of the patient&apos;s maxillary teeth.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:15:55Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">removable maxillary partial denture procedure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000292 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000292">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000250"/>
        <obo:IAO_0000115 xml:lang="en">A removable partial denture procedure in which the prosthesis being constructed or fitted replaces some but not all of the patient&apos;s mandibular teeth.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:15:07Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">removable mandibular partial denture procedure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000293 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000293">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000278"/>
        <obo:IAO_0000115 xml:lang="en">A dental implant body that is placed in the mouth for short duration of time in order to allow adequate time for healing or completion of definitive treatment planning.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-12-06T04:24:01Z</oboInOwl:creation_date>
        <rdfs:label xml:lang="en">interim dental implant body</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000294 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000294">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000280"/>
