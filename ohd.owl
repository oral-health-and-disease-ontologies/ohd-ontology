    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000276 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000276">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000407"/>
        <obo:IAO_0000115 xml:lang="en">A bruxism that occurs during sleep and is characterised by rhythmic (phasic) or non-rhythmic (tonic) movements of the jaw.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0006-7251-3026"/>
