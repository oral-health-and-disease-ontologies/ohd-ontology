    <!-- http://purl.obolibrary.org/obo/OHD_0000455 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000455">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PATO_0001652"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
