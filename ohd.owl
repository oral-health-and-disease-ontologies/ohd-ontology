            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A processed material that bears a dental restoration material role.</obo:IAO_0000115>
        <obo:IAO_0000118>restoration material</obo:IAO_0000118>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
