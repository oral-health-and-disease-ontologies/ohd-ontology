        <oboInOwl:hasDbXref>MFMO:0000046</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:303404000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Capsule_of_temporomandibular_joint</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>articular capsule of temporomandibular joint</oboInOwl:hasExactSynonym>
