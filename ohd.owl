    <!-- http://purl.obolibrary.org/obo/UBERON_0002468 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002468">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0014389"/>
        <obo:IAO_0000115>Any of the papillae located on the sides of the tongue.</obo:IAO_0000115>
        <obo:UBPROP_0000001>Taste-buds, the end-organs of the gustatory sense, are scattered over the mucous membrane of the mouth and tongue at irregular intervals. They occur especially in the sides of the vallate papillae. There is a localized area at the side of the base of the tongue, the foliate papillae, in which they are especially abundant. [WP,unvetted][Wikipedia:Foliate_papilla].</obo:UBPROP_0000001>
        <oboInOwl:hasDbXref>BIRNLEX:4105</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:32788</oboInOwl:hasDbXref>
