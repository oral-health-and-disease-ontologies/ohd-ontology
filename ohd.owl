    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000275 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000275">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000274"/>
