        <obo:IAO_0000115 xml:lang="en">A dental finding that is about some fractured tooth.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0002-7282-0836"/>
        <rdfs:label xml:lang="en">fractured tooth finding</rdfs:label>
