        <rdfs:label xml:lang="en">pulpal pain due to irreversible pulpitis resulting from a dental hard-tissue fracture without pulp exposure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PAIN_0010161 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0010161">
