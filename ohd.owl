        <rdfs:comment>ICOP number: 4.1.2.3.1</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ohd/imports/pain_import.owl"/>
        <rdfs:label xml:lang="en">probable post-traumatic trigeminal neuropathic pain</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/PAIN_0010304 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0010304">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0010275"/>
