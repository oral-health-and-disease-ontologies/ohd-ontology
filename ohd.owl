        <obo:IAO_0000115 xml:lang="en">A prothetic tooth that is part of a fixed partial denture.</obo:IAO_0000115>
        <obo:IAO_0000117>Bill Duncan</obo:IAO_0000117>
        <rdfs:label xml:lang="en">pontic</rdfs:label>
    </owl:Class>
    


