    <!-- http://purl.obolibrary.org/obo/OHD_0000065 -->

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/OHD_0000065">
        <obo:IAO_0000115 xml:lang="en">An alternative label for human teeth designated by the American Dental Association.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0002-7282-0836"/>
