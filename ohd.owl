    <!-- http://purl.obolibrary.org/obo/UBERON_0016397 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0016397">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0015870"/>
        <obo:IAO_0000115>The submental lymph nodes (or suprahyoid) are situated between the anterior bellies of the Digastrici. Their afferents drain the central portions of the lower lip and floor of the mouth and the apex of the tongue. Their efferents pass partly to the submandibular lymph nodes and partly to a gland of the deep cervical group situated on the internal jugular vein at the level of the cricoid cartilage.</obo:IAO_0000115>
        <obo:RO_0002174 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10090"/>
        <oboInOwl:hasDbXref>FMA:61229</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:245318006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Submental_lymph_nodes</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>level Ia neck node</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>submental node</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>submental glands</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>suprahyoid glands</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0016397</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#mouse_subset"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/ohd/imports/uberon_import.owl"/>
        <rdfs:label>submental lymph node</rdfs:label>
    </owl:Class>
