    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0010132 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0010132">
        <rdfs:subClassOf rdf:resource="http://www.geneontology.org/formats/oboInOwl#ObsoleteClass"/>
        <obo:IAO_0000115 xml:lang="en">OBSOLETE. Orofacial pain attributed to lesion or disease of the glossopharyngeal nerve.</obo:IAO_0000115>
        <obo:IAO_0000119>PMID:32103673</obo:IAO_0000119>
        <obo:IAO_0000231 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000228"/>
