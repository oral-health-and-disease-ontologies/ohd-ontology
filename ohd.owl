            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A alignment quality that characterizes how at least one upper tooth and at least one lower tooth spatialy relate to one another during static or dynamic maximal contact.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-06-10T22:48:05Z</dcterms:created>
        <oboInOwl:hasExactSynonym>occlusion</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">tooth occlusal quality</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/OHD_0000455"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A alignment quality that characterizes how at least one upper tooth and at least one lower tooth spatialy relate to one another during static or dynamic maximal contact.</owl:annotatedTarget>
        <obo:IAO_0000119>https://aaoinfo.org/resources/glossary-of-orthodontic-terms/</obo:IAO_0000119>
        <obo:IAO_0000119>https://pmc.ncbi.nlm.nih.gov/articles/PMC11624512/</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/books/NBK570625/</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000456 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000456">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000452"/>
        <obo:IAO_0000115 xml:lang="en">An Angle&apos;s classification finding in which the back molars meet properly, but the front teeth may appear to be crowded together or spaced apart.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-06-10T22:54:55Z</dcterms:created>
        <dcterms:description>The maxillary teeth are slightly forward of the mandibular teeth, and the jaw is aligned properly. With a Class I Malocclusion, there may be an overbite, an openbite, a posterior (back) crossbite or an anterior (front) crossbite.</dcterms:description>
        <rdfs:label xml:lang="en">Class I occlusion finding</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/OHD_0000456"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">An Angle&apos;s classification finding in which the back molars meet properly, but the front teeth may appear to be crowded together or spaced apart.</owl:annotatedTarget>
        <obo:IAO_0000119>https://aaoinfo.org/resources/glossary-of-orthodontic-terms/</obo:IAO_0000119>
        <obo:IAO_0000119>https://pmc.ncbi.nlm.nih.gov/articles/PMC11340269/</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000457 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000457">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000452"/>
        <obo:IAO_0000115 xml:lang="en">An Angle&apos;s classification finding in which the positioning of the upper front teeth further forward than the lower teeth. Also known as an overbite.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-06-10T22:55:03Z</dcterms:created>
        <dcterms:description>The maxillary teeth are significantly forward of the mandibular teeth, and the jaw is underdeveloped.</dcterms:description>
        <rdfs:label xml:lang="en">Class II occlusion finding</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/OHD_0000457"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">An Angle&apos;s classification finding in which the positioning of the upper front teeth further forward than the lower teeth. Also known as an overbite.</owl:annotatedTarget>
        <obo:IAO_0000119>https://aaoinfo.org/resources/glossary-of-orthodontic-terms/</obo:IAO_0000119>
        <obo:IAO_0000119>https://sequenceorthodontics.com/orthodontic-dictionary/</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/books/NBK592395/</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/OHD_0000458 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OHD_0000458">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OHD_0000452"/>
        <obo:IAO_0000115 xml:lang="en">An Angle&apos;s classification finding in which the positioning of the lower front teeth further forward than the upper teeth. Also known as an underbite.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-06-10T22:55:11Z</dcterms:created>
        <dcterms:description>The mandibular teeth are significantly forward of the maxillary teeth, and the jaw is overdeveloped.</dcterms:description>
        <rdfs:label xml:lang="en">Class III occlusion finding</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/OHD_0000458"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">An Angle&apos;s classification finding in which the positioning of the lower front teeth further forward than the upper teeth. Also known as an underbite.</owl:annotatedTarget>
        <obo:IAO_0000119>https://aaoinfo.org/resources/glossary-of-orthodontic-terms/</obo:IAO_0000119>
        <obo:IAO_0000119>https://sequenceorthodontics.com/orthodontic-dictionary/</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/books/NBK592395/</obo:IAO_0000119>
    </owl:Axiom>
    


