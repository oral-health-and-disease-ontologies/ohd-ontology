    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PAIN_0010178">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PAIN_0010102"/>
        <obo:IAO_0000115>Periodontal pain due to periodontal disease that results from a systematic disorder.</obo:IAO_0000115>
