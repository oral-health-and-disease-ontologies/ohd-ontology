        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Anatomical structure that is part of the head consisting entirely of cranium and mandible[WP].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:11523816</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Skull</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>http://sourceforge.net/tracker/?func=detail&amp;aid=2962656&amp;group_id=76834&amp;atid=1205376</oboInOwl:hasDbXref>
