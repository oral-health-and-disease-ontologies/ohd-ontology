        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-07-07T17:23:06Z</dcterms:created>
        <rdfs:label xml:lang="en">obsolete short-lasting unilateral neuralgiform facial pain attacks with cranial autonomic symptoms (SUNFA)</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


