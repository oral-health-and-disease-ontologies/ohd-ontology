        <obo:IAO_0000115 xml:lang="en">An inlay restoration procedure that uses high noble metal to restore the tooth.</obo:IAO_0000115>
        <obo:IAO_0000117>An inlay restoration procedure that uses high noble metal to restore the tooth.</obo:IAO_0000117>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
