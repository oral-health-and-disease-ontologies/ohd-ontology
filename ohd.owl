        <oboInOwl:hasDbXref>ZFA:0005333</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>glossus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001723</oboInOwl:id>
