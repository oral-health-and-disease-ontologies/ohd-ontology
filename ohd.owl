 ISBN:1935201387#CDT 2011-2012 Current Dental Terminology, Chapter 1</obo:IAO_0000116>
        <obo:cdt_label>apicoectomy/periradicular surgery - molar (first root)</obo:cdt_label>
        <dc:identifier>D3425</dc:identifier>
