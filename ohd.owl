    <!-- http://purl.obolibrary.org/obo/EMRO_0003000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMRO_0003000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0002209"/>
        <obo:IAO_0000115 xml:lang="en">A behavioral defense response in which an organism seeks to avoid an encounter with a potential external threat.</obo:IAO_0000115>
        <obo:IAO_0000589 xml:lang="en">avoidance behavior (EMRO)</obo:IAO_0000589>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9990-8331"/>
