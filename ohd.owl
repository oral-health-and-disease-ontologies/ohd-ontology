        <oboInOwl:hasDbXref>FMA:59679</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:355</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000431</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D010256</oboInOwl:hasDbXref>
