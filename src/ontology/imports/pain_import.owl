AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PAIN_0010275> "ICOP number: 6")
AnnotationAssertion(rdfs:isDefinedBy <http://purl.obolibrary.org/obo/PAIN_0010275> <http://purl.obolibrary.org/obo/ohd/imports/pain_import.owl>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PAIN_0010275> "idiopathic orofacial pain"@en)
