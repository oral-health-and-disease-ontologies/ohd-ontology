AnnotationAssertion(rdfs:isDefinedBy <http://purl.obolibrary.org/obo/PAIN_0010257> <http://purl.obolibrary.org/obo/ohd/imports/pain_import.owl>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PAIN_0010257> "episodic orofacial migraine"@en)
SubClassOf(<http://purl.obolibrary.org/obo/PAIN_0010257> <http://purl.obolibrary.org/obo/PAIN_0010256>)

# Class: <http://purl.obolibrary.org/obo/PAIN_0010258> (chronic orofacial migraine)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PAIN_0010258> "Facial or oral pain occurring on 15 or more days per month for more than 3 months, which has the features of migraine on at least 8 days per month.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/PAIN_0010258> "PMID:32103673")
