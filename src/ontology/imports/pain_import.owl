AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/PAIN_0010254> <http://purl.obolibrary.org/obo/PAIN_0010296>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PAIN_0010254> "ICOP number: 4.2.2.2")
AnnotationAssertion(rdfs:isDefinedBy <http://purl.obolibrary.org/obo/PAIN_0010254> <http://purl.obolibrary.org/obo/ohd/imports/pain_import.owl>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PAIN_0010254> "idiopathic glossopharyngeal neuropathic pain"@en)
