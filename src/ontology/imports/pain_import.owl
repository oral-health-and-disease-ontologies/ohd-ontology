# Class: <http://purl.obolibrary.org/obo/UBERON_0003129> (skull)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11523816") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Skull") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://sourceforge.net/tracker/?func=detail&aid=2962656&group_id=76834&atid=1205376") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0003129> "Anatomical structure that is part of the head consisting entirely of cranium and mandible[WP].")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#external_ontology> "FMA") <http://purl.obolibrary.org/obo/UBPROP_0000012> <http://purl.obolibrary.org/obo/UBERON_0003129> "in FMA the skull is divided into orbit, neurocranium (8 parts), viscerocranium (26 parts). Here we have a separate overlapping division into cranium and mandible.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000012> <http://purl.obolibrary.org/obo/UBERON_0003129> "in many ontologies, the structure called the cranium is inclusive of the mandible/lower jaw skeleton")
