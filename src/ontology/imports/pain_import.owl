AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PAIN_0010300> "trigeminal neuropathic pain attributed to herpes zoster"@en)
SubClassOf(<http://purl.obolibrary.org/obo/PAIN_0010300> <http://purl.obolibrary.org/obo/PAIN_0010299>)

# Class: <http://purl.obolibrary.org/obo/PAIN_0010301> (trigeminal postherpetic neuralgia)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PAIN_0010301> "Unilateral facial pain persisting or recurring for at least 3 months in the distribution(s) of one or more branches of the trigeminal nerve, with variable sensory changes, caused by herpes zoster.")
