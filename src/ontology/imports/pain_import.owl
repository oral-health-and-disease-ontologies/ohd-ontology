# Class: <http://purl.obolibrary.org/obo/PAIN_0010261> (orofacial cluster attacks)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PAIN_0010261> "Attacks of severe, strictly unilateral facial and/or oral pain, without head pain, lasting 15–180 minutes and occurring from once every other day to eight times a day. The pain is associated with ipsilateral conjunctival injection, lacrimation, nasal congestion, rhinorrhoea, forehead and facial sweating, miosis, ptosis and/or eyelid oedema, and/or with restlessness or agitation.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000119> <http://purl.obolibrary.org/obo/PAIN_0010261> "PMID:32103673")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/PAIN_0010261> <https://orcid.org/0009-0003-5583-4731>)
AnnotationAssertion(<http://purl.org/dc/terms/created> <http://purl.obolibrary.org/obo/PAIN_0010261> "2025-07-07T17:16:21Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/PAIN_0010261> <http://purl.obolibrary.org/obo/PAIN_0010296>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PAIN_0010261> "ICOP number: 5.3.1")
AnnotationAssertion(rdfs:isDefinedBy <http://purl.obolibrary.org/obo/PAIN_0010261> <http://purl.obolibrary.org/obo/ohd/imports/pain_import.owl>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PAIN_0010261> "orofacial cluster attacks"@en)
SubClassOf(<http://purl.obolibrary.org/obo/PAIN_0010261> <http://purl.obolibrary.org/obo/PAIN_0010260>)

