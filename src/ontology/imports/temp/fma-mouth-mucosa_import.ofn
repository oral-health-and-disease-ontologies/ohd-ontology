AnnotationAssertion(rdfs:label obo:FMA_85927 "constitutional part of")
SubObjectPropertyOf(obo:FMA_85927 obo:FMA_85848)
TransitiveObjectProperty(obo:FMA_85927)

# Object Property: obo:FMA_85994 (branch of)

AnnotationAssertion(obo:IAO_0000116 obo:FMA_85994 "<br><b>type</b>: slot<br><b>is-a</b>: Structural slot<br><b>slot synonym</b>: arises from<br><b>:slot-inverse</b>: branch<br><b>:slot-value-type</b>: Class, Postnatal anatomical structure<br><b>:direct-domain</b>: Conducting tissue of heart, Root of median nerve, Tributary of hepatic portal vein, Trunk of branch of internal iliac artery, Trunk of branch of external iliac artery, Segment of trunk of external iliac artery, Arteriole, Trunk of branch of left colic artery, Variant systemic artery, Arterial anastomosis, Thyrocervical trunk, Costocervical trunk, Septal branch of right posterior interventricular artery<br><b>:documentation</b>: Regional_part_of relation which holds between trunks and subtrees of a tree organ that is either tracheobronchial or biliary or of arterial or neural type.<br><b>:direct-superslots</b>: regional part of")
