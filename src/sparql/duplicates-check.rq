prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
SELECT ?p ?o (LANG(?o) AS ?lang) (DATATYPE(?o) AS ?dt) ?axProp ?axVal WHERE {
  ?s rdfs:label ?l .
  FILTER(STR(?l) = "oral mucosal inflammation due to viral infection")
  ?s ?p ?o .
  FILTER(isLiteral(?o))
  OPTIONAL {
    ?ax owl:annotatedSource ?s ; owl:annotatedProperty ?p ; owl:annotatedTarget ?o ;
        ?axProp ?axVal .
    FILTER(?axProp NOT IN (rdf:type, owl:annotatedSource, owl:annotatedProperty, owl:annotatedTarget))
  }
}
ORDER BY ?p ?o